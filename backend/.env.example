# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/formiq?retryWrites=true&w=majority
DATABASE_PASSWORD=your_mongodb_password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
# Optional – override the Groq models (defaults: openai/gpt-oss-120b, openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_email@yourdomain.com

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
