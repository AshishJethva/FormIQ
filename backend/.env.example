# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE=mongodb+srv://username:<PASSWORD>@cluster.mongodb.net/formapp?retryWrites=true&w=majority
DATABASE_PASSWORD=your_mongodb_password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate_with_node_crypto_randomBytes_64_hex
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_from_aistudio_google_com

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://formiq.ashishjethva.com

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
