        "description": "Updated description for the contact form"
      }
    },
    "10_update_form_with_fields": {
      "method": "PUT",
      "url": "{{baseUrl}}/forms/{{formId}}",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "{{token}}"
      },
      "body": {
        "title": "Complete Contact Form",
        "description": "Full contact form with all necessary fields",
        "pages": [
          {
            "id": "page-1",
            "fields": [
              {
                "id": "field-1",
                "type": "heading",
                "label": "Contact Information",
                "required": false,
                "labelAlignment": "LEFT"
              },
              {
                "id": "field-2",
                "type": "fullName",
                "label": "Full Name",
                "required": true,
                "labelAlignment": "LEFT",
                "placeholder": "Enter your full name",
                "helpText": "Please provide your first and last name"
              },
              {
                "id": "field-3",
                "type": "email",
                "label": "Email Address",
                "required": true,
                "labelAlignment": "LEFT",
                "placeholder": "your.email@example.com",
                "helpText": "We'll never share your email address"
              },
              {
                "id": "field-4",
                "type": "phone",
                "label": "Phone Number",
                "required": false,
                "labelAlignment": "LEFT",
                "placeholder": "+1 (555) 123-4567",
                "helpText": "Include country code if outside US"
              },
              {
                "id": "field-5",
                "type": "address",
                "label": "Address",
                "required": false,
                "labelAlignment": "LEFT",
                "placeholder": "Street, City, State, ZIP"
              }
            ]
          }
        ],
        "settings": {
          "submitButtonText": "Send Message",
          "thankyouMessage": "Thank you for contacting us! We'll get back to you within 24 hours.",
          "defaultLabelAlignment": "LEFT",
          "defaultRequiredField": false,
          "showLogo": true
        }
      }
    },
    "11_update_form_with_logo": {
      "method": "PUT",
      "url": "{{baseUrl}}/forms/{{formId}}",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "{{token}}"
      },
      "body": {
        "logo": {
          "src": "https://example.com/logo.png",
          "type": "url",
          "alignment": "CENTER",
          "size": 75
        }
      }
    },
    "12_update_complex_form": {
      "method": "PUT",
      "url": "{{baseUrl}}/forms/{{formId}}",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "{{token}}"
      },
      "body": {
        "title": "Advanced Job Application",
        "pages": [
          {
            "id": "page-1",
            "fields": [
              {
                "id": "field-1",
                "type": "heading",
                "label": "Personal Information",
                "required": false,
                "labelAlignment": "LEFT"
              },
              {
                "id": "field-2",
                "type": "fullName",
                "label": "Full Name",
                "required": true,
                "labelAlignment": "LEFT"
              },
              {
                "id": "field-3",
                "type": "email",
                "label": "Email Address",
                "required": true,
                "labelAlignment": "LEFT"
              },
              {
                "id": "field-4",
                "type": "phone",
                "label": "Phone Number",
                "required": true,
                "labelAlignment": "LEFT"
              },
              {
                "id": "field-5",
                "type": "datePicker",
                "label": "Date of Birth",
                "required": false,
                "labelAlignment": "LEFT"
              }
            ]
          },
          {
            "id": "page-2",
            "fields": [
              {
                "id": "field-6",
                "type": "heading",
                "label": "Professional Experience",
                "required": false,
                "labelAlignment": "LEFT"
              },
              {
                "id": "field-7",
                "type": "fillBlank",
                "label": "Current Position",
                "required": true,
                "labelAlignment": "LEFT",
                "placeholder": "Your current job title"
              },
              {
                "id": "field-8",
                "type": "signature",
                "label": "Digital Signature",
                "required": true,
                "labelAlignment": "LEFT",
                "helpText": "Please sign to confirm the information is accurate"
              }
            ]
          }
        ],
        "settings": {
          "submitButtonText": "Submit Application",
          "thankyouMessage": "Thank you for your application! We will review it and get back to you soon.",
          "defaultLabelAlignment": "LEFT",
          "defaultRequiredField": false
        },
        "isPublished": true
      }
    },
