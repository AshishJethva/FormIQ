{
  "info": {
    "name": "FormIQ API Complete Test Collection",
    "description": "Comprehensive test data for all FormIQ backend API endpoints",
    "version": "1.0.0",
    "baseUrl": "http://localhost:5000/api"
  },
  "environment": {
    "baseUrl": "http://localhost:5000/api",
    "token": "Bearer YOUR_JWT_TOKEN_HERE",
    "userId": "USER_ID_FROM_REGISTRATION",
    "formId": "FORM_ID_FROM_CREATION",
    "labelId": "LABEL_ID_FROM_CREATION",
    "submissionId": "SUBMISSION_ID_FROM_SUBMISSION"
  },
  "labels": {
