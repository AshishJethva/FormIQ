  "error_testing": {
    "1_invalid_authentication": {
      "method": "GET",
      "url": "{{baseUrl}}/forms",
      "headers": {
        "Authorization": "Bearer invalid_token_here"
      },
      "expected_status": 401,
      "expected_response": {
        "success": false,
        "error": "Not authorized to access this route"
      }
    },
    "2_missing_required_fields": {
      "method": "POST",
      "url": "{{baseUrl}}/forms",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "{{token}}"
      },
      "body": {
        "description": "Form without name"
      },
      "expected_status": 400,
      "expected_response": {
        "success": false,
        "error": "Validation error: name: Form name is required"
      }
    },
    "3_invalid_email_format": {
      "method": "POST",
      "url": "{{baseUrl}}/auth/register",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Test User",
        "email": "invalid-email",
        "password": "password123",
        "passwordConfirm": "password123"
      },
      "expected_status": 400
    },
    "4_password_mismatch": {
      "method": "POST",
      "url": "{{baseUrl}}/auth/register",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Test User",
        "email": "test@example.com",
        "password": "password123",
        "passwordConfirm": "different_password"
      },
      "expected_status": 400
    },
    "5_duplicate_email": {
      "method": "POST",
      "url": "{{baseUrl}}/auth/register",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Another User",
        "email": "john.doe@example.com",
        "password": "password123",
        "passwordConfirm": "password123"
      },
      "expected_status": 400,
      "note": "Should fail because email already exists"
    },
    "6_invalid_form_id": {
      "method": "GET",
      "url": "{{baseUrl}}/forms/invalid_id_format",
      "headers": {
        "Authorization": "{{token}}"
      },
      "expected_status": 404
    },
    "7_access_other_users_form": {
      "method": "GET",
      "url": "{{baseUrl}}/forms/507f1f77bcf86cd799439011",
      "headers": {
        "Authorization": "{{token}}"
      },
      "expected_status": 404,
      "note": "Should fail when trying to access form that doesn't belong to user"
    },
    "8_submit_to_unpublished_form": {
      "method": "POST",
      "url": "{{baseUrl}}/submissions/{{formId}}/submit",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "data": {
          "test": "data"
        }
      },
      "expected_status": 400,
      "note": "Should fail if form is not published"
    },
    "9_invalid_color_format": {
      "method": "POST",
      "url": "{{baseUrl}}/labels",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "{{token}}"
